<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pascal_search_faa_typesense"/>
    <Author Value="Fabiano Arndt"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\src"/>
        <OtherUnitFiles Value="..\adapters\typesense"/>
        <UnitOutputDirectory Value="lib-typesense\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="pascal-search-faa on Typesense (30.2 probed): the search contract over pascal-common-faa's HTTP client, with TLS verified on both compilers."/>
    <License Value="MIT"/>
    <Version Minor="2"/>
    <Files>
      <Item>
        <Filename Value="..\adapters\typesense\PascalSearch.Typesense.pas"/>
        <UnitName Value="PascalSearch.Typesense"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="pascal_search_faa"/>
        <MinVersion Minor="2" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_common_faa"/>
        <MinVersion Major="1" Minor="31" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="pascaljsonmapper_pkg"/>
        <MinVersion Minor="7" Valid="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
